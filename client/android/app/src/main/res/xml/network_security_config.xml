<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration for Finvo.

  Cleartext (HTTP) is permitted because Finvo is a self-hosted app whose
  users may connect to a server on their local network (e.g.
  http://192.168.1.100:8080). Android's <domain> element cannot match IP
  ranges, so we cannot restrict cleartext to private addresses only.

  User-installed CA certificates are trusted so that self-hosted servers
  using self-signed HTTPS certificates work without disabling certificate
  verification — encouraging HTTPS even for local deployments.

  iOS achieves a tighter policy via NSAllowsLocalNetworking (public domains
  require HTTPS). For Android, a runtime warning in the server-config UI
  should discourage configuring public HTTP URLs.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
